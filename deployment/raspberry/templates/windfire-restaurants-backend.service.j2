[Unit]
Description=Windfire Restaurants Backend
After=network.target

[Service]
Type=simple
User={{ user }}
WorkingDirectory={{ remote_windfirerestaurants_dir }}
EnvironmentFile={{ remote_windfirerestaurants_dir }}/windfire-restaurants-backend.env
LoadCredentialEncrypted=windfire-restaurants-backend-secrets:/etc/credstore.encrypted/windfire-restaurants-backend-secrets
ExecStart=/bin/bash -c 'set -a; source "$CREDENTIALS_DIRECTORY/windfire-restaurants-backend-secrets"; set +a; exec /usr/bin/java -jar {{ remote_windfirerestaurants_run_target_dir }}/{{ windfirerestaurants_app_jar }}'
Restart=on-failure
RestartSec=5
StandardOutput=append:{{ remote_windfirerestaurants_dir }}/logs/windfire-restaurants-backend.log
StandardError=append:{{ remote_windfirerestaurants_dir }}/logs/windfire-restaurants-backend.log
# Sandboxing. ProtectSystem=strict and ProtectHome=read-only make the whole filesystem
# read-only; ReadWritePaths re-opens only the logs dir, the one place the service writes.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ remote_windfirerestaurants_dir }}/logs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
# No MemoryDenyWriteExecute: the JVM JIT needs writable+executable memory.

[Install]
WantedBy=multi-user.target
