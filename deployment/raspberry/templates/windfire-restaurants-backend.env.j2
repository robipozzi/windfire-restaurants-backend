KEYCLOAK_SERVER={{ keycloak_server }}
KEYCLOAK_SERVER_PORT={{ keycloak_server_port }}
KEYCLOAK_ISSUER_URL={{ keycloak_issuer_url }}
HOME_DIR={{ remote_home_dir }}
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins | join(',') }}
MONGODB_HOST={{ mongodb_host }}
MONGODB_USER={{ mongodb_user }}
LOGGING_FILE_NAME={{ remote_windfirerestaurants_dir }}/logs/windfire-restaurants-backend.log
# These override the ${HOME_DIR}-based paths in application.properties.
# Certificate and key: the service user's own copy in {{ remote_windfirerestaurants_ssl_dir }}, readable only by it
SERVER_SSL_CERTIFICATE=file:{{ remote_windfirerestaurants_ssl_dir }}/{{ remote_windfirerestaurants_certificate }}
SERVER_SSL_CERTIFICATEPRIVATEKEY=file:{{ remote_windfirerestaurants_ssl_dir }}/{{ remote_windfirerestaurants_key }}
# Windfire Keycloak Root CA: the shared, root-owned copy installed by windfire-raspberry (configure-windfire-infra.sh --tags windfire_ca)
SPRING_SSL_BUNDLE_PEM_KEYCLOAK_TRUSTSTORE_CERTIFICATE=file:{{ windfire_ca_dir }}/{{ keycloak_root_ca_certificate }}
